# --- Web Chat App Configuration ---
# MySQL DSN (Async): mysql+asyncmy://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=mysql+asyncmy://chatuser:chatpass@localhost:3306/groupchat

# JWT secret for signing access tokens (set to a long random string!)
JWT_SECRET=please_change_me_to_a_long_random_value
# Token expiration in minutes (default: 43200 = 30 days)
JWT_EXPIRE_MINUTES=43200

# LLM API (self-hosted Llama 3 compatible endpoint, e.g., llama.cpp server or vLLM with OpenAI-compatible API)
LLM_API_BASE=http://localhost:8001/v1
LLM_MODEL=llama-3.2-3b-instruct
# Optional API key if your server enforces one
LLM_API_KEY=

# Host/Port for the FastAPI app
APP_HOST=0.0.0.0
APP_PORT=8000

# --- OIS Assistant (RAG) ---
# OpenAI key, used only for embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
# Not-covered threshold for the OpenAI embedding. The Part 5 histogram models use the
# calibrated per-model values in data/models/thresholds.json (eval_retrieval.py --calibrate).
RAG_MIN_SCORE=0.30
